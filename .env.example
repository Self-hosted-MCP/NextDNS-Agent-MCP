# Copy to ~/.config/nextdns-agent-mcp/.env (or set these as environment variables).

# Your API key: the bottom of https://my.nextdns.io/account
NEXTDNS_API_KEY=

# Your API key can also be pasted on the settings page of the web version instead.

# What the AI may do with each profile: full (read and change), read (read only) or hidden.
# Profiles not listed get NEXTDNS_DEFAULT_MODE (full unless you change it). Also on the settings page.
# Example: NEXTDNS_PROFILES=abc123=full,def456=hidden
NEXTDNS_PROFILES=
NEXTDNS_DEFAULT_MODE=full

# The profile tools use when none is named (only needed if the AI may see more than one).
NEXTDNS_DEFAULT_PROFILE=

# on: nothing can be changed, whatever the profile modes say.
NEXTDNS_READ_ONLY=off

# off: the AI can never delete profiles or clear logs. On by default, and each time it needs a double confirmation.
NEXTDNS_ALLOW_DELETE=on

# At most this many changes a minute, a brake for a runaway AI (default 30).
NEXTDNS_CHANGE_LIMIT=30

# The name shown in the change log for this app (default: AI app).
NEXTDNS_APP_NAME=

# ---- web version (serve) ----
# The passphrase for the login and settings pages, 6+ characters (or run set-passphrase to store only its hash).
LOGIN_PASSPHRASE=
# The HTTPS address the server is reached at, for phones and claude.ai.
PUBLIC_URL=
# HOST=127.0.0.1
# PORT=8766
# Encrypts the API key saved on the settings page. Set it on hosting, so a copy of the data folder alone is useless.
# NEXTDNS_SECRET_KEY=
