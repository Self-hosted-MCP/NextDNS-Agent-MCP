# NextDNS-Agent-MCP settings. Every setting: docs/settings.md
#
# On a computer, copy this file to ~/.config/nextdns-agent-mcp/.env and keep it private:
#   chmod 600 ~/.config/nextdns-agent-mcp/.env
# On a hosting company, set these as variables instead.
# Environment variables win over this file; this file wins over the settings page.
# on / true / yes / 1 all mean on.


# ---- NextDNS ----

# Your API key: sign in at https://my.nextdns.io/account, scroll to the bottom (API), show it and copy it.
# With the web version you can paste it on the settings page instead (stored encrypted).
NEXTDNS_API_KEY=


# ---- Profiles (docs/profiles.md) ----

# What the AI may do with each profile: full (read and change), read (read only) or hidden.
# Use the profile's ID or its name. Also on the settings page.
# Example: NEXTDNS_PROFILES=abc123=full,Kids=read,Work laptop=hidden
NEXTDNS_PROFILES=

# The mode for profiles not listed above: full (the default), read or hidden.
NEXTDNS_DEFAULT_MODE=full

# The profile used when the AI names none (ID or name). Only needed with several profiles.
NEXTDNS_DEFAULT_PROFILE=


# ---- Safety (docs/safety.md) ----

# on: nothing can be changed, by any app.
NEXTDNS_READ_ONLY=off

# off: the AI can never delete profiles or clear logs. On, it must ask you twice each time.
NEXTDNS_ALLOW_DELETE=on

# At most this many changes a minute, a brake for a runaway AI.
NEXTDNS_CHANGE_LIMIT=30

# The name shown in the change log for apps on this computer.
NEXTDNS_APP_NAME=

# on: once a day, ask GitHub which release is newest and tell you (sends nothing about you).
UPDATE_CHECK=off


# ---- Web version: nextdns-agent-mcp serve (docs/setup-hosting.md) ----

# The passphrase for the login and settings pages, 6 or more characters.
# Or run "nextdns-agent-mcp set-passphrase" to store only its hash (LOGIN_HASH).
LOGIN_PASSPHRASE=
# LOGIN_HASH=

# The HTTPS address it's reached at, without /mcp. Render and Railway set it by themselves.
PUBLIC_URL=

# Where it listens. Docker uses 0.0.0.0.
# HOST=127.0.0.1
# PORT=8766

# Encrypts the API key saved on the settings page. Any long random text (openssl rand -hex 32).
# Set it on hosting, so a copy of the data folder alone is useless. Never change it later.
# NEXTDNS_SECRET_KEY=

# AI apps allowed to receive a login (localhost always is), comma-separated.
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com,vscode.dev

# off: no settings page (AI app logins still work).
# SETTINGS_PAGE=on


# ---- Folders (environment only, not read from this file) ----
# NEXTDNS_CONFIG_DIR=~/.config/nextdns-agent-mcp
# NEXTDNS_ENV_FILE=<config folder>/.env
# NEXTDNS_DATA_DIR=<config folder>/state
